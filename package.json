{
  "name": "fly67",
  "version": "1.0.0",
  "description": "A whole fruit fly brain (FlyWire connectome, 138,639 neurons) simulated live in the browser and wired to a virtual fly.",
  "type": "module",
  "license": "MIT",
  "author": "Ruben Nugmanov (znatgost)",
  "repository": "github:znatgost/fly67",
  "keywords": ["connectome", "drosophila", "flywire", "spiking-neural-network", "neuroscience", "webgl", "simulation"],
  "scripts": {
    "start": "npx --yes serve -l 8080 .",
    "test": "node --test test/*.test.mjs",
    "validate": "node validation/validate.mjs && node validation/lazy_vs_dense.mjs",
    "circuits": "node tools/probe.mjs --circuits",
    "build-data": "bash tools/fetch_sources.sh && python3 tools/build_data.py"
  },
  "engines": { "node": ">=20" }
}
